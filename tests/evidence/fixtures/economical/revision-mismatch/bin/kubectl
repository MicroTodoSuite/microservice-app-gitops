#!/usr/bin/env bash
set -euo pipefail
DIR="${ECONOMICAL_FIXTURE_DIR:?fixture dir not set}"
[[ -f "$DIR/unreachable" ]] && { echo "Unable to connect to the server" >&2; exit 1; }
for arg in "$@"; do
  case "$arg" in
    applications) cat "$DIR/applications.json"; exit 0 ;;
    pods) cat "$DIR/pods.json"; exit 0 ;;
    endpoints) cat "$DIR/endpoints.json"; exit 0 ;;
    networkpolicies) cat "$DIR/networkpolicies.json"; exit 0 ;;
  esac
done
echo '{"items":[]}'
