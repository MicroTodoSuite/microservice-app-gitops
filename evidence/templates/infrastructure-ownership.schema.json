{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microtodosuite.online/schemas/infrastructure-ownership-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resources"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceId", "kind", "ownerState", "consumers", "preventDestroy", "status"],
        "properties": {
          "resourceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./:_-]+$"},
          "kind": {"type": "string", "minLength": 1},
          "ownerState": {"type": "string", "minLength": 1},
          "consumers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "preventDestroy": {"type": "boolean"},
          "status": {"enum": ["existing", "existing-retained", "planned"]}
        }
      }
    }
  }
}
