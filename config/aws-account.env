# The single declaration of the AWS account this repository targets.
#
# Change it with scripts/set-aws-account.sh <new-account-id>, never by hand: the
# script rewrites every tracked file that carries the account, retires the
# previous value, and runs tests/contract/aws-account-parameter.sh.
#
# Parsed as data, never sourced. Keep exactly this KEY=VALUE shape.
AWS_ACCOUNT_ID=575172595729
RETIRED_AWS_ACCOUNT_IDS="995253610162 916491575487"
