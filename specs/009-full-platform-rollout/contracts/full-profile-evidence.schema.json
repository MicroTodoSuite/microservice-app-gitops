{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microtodosuite.online/schemas/full-profile-evidence-1.0.0.json",
  "title": "MicroTodoSuite full-profile stage evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stageId",
    "generatedAt",
    "scope",
    "identities",
    "baseline",
    "artifacts",
    "requirements",
    "rollback",
    "postBaseline",
    "decision"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "stageId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories", "destinations", "stateKeys", "capabilities"],
      "properties": {
        "repositories": { "$ref": "#/$defs/nonEmptyStrings" },
        "destinations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "stateKeys": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitActor"],
      "properties": {
        "gitActor": { "type": "string", "minLength": 1 },
        "awsAccountId": { "const": "916491575487" },
        "awsArn": { "type": "string", "pattern": "^arn:aws:(iam|sts)::916491575487:" },
        "azureSubscriptionId": { "type": "string", "minLength": 1 },
        "azureTenantIdHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "baseline": { "$ref": "#/$defs/check" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "result"],
        "properties": {
          "kind": {
            "enum": [
              "identity",
              "backend",
              "state-backup",
              "terraform-plan",
              "quota",
              "infracost",
              "approval",
              "gitops-render",
              "desired-state",
              "live-success",
              "failure-mode",
              "rollback",
              "continuity",
              "post-baseline"
            ]
          },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "producer": { "type": "string" },
          "result": { "enum": ["pass", "fail", "not-applicable"] },
          "approvedBy": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "approval" } }, "required": ["kind"] },
            "then": { "required": ["approvedBy"] }
          }
        ]
      }
    },
    "requirements": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^(FR|SC)-[0-9]{3}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result", "evidence"],
        "properties": {
          "result": { "enum": ["pass", "fail", "blocked"] },
          "evidence": { "$ref": "#/$defs/nonEmptyStrings" }
        }
      }
    },
    "rollback": { "$ref": "#/$defs/check" },
    "postBaseline": { "$ref": "#/$defs/check" },
    "decision": { "enum": ["pending", "approved", "accepted", "blocked", "rejected", "rolled-back"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "evidence"],
      "properties": {
        "result": { "enum": ["pass", "fail", "blocked"] },
        "evidence": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  }
}
